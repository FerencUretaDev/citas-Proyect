Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Proteccion de dependencias de Composer
RewriteRule ^vendor(?:/|$) - [F,END,NC]
RewriteRule ^composer\.(?:json|lock)(?:/|$) - [F,END,NC]

# Bloquear solicitudes HTTP a capas internas, respaldos y archivos sensibles.
RewriteRule ^(?:controladores|servicios|repositorios|modelos|vistas|middlewares|config|pruebas|migraciones|modulo-reportes)(?:/|$) - [F,END,NC]
RewriteRule (^|/)\. - [F,END]
RewriteRule \.(?:sql|bak|ini|log|zip|jar|xlsx|env)(?:/|$) - [F,END,NC]
RewriteRule ^(?:conexion|generar_usuario|catalogo_especialidades|reglas_citas|reglas_reserva|sesion_activa|sidebar|prueba_java|verificar_curl)(?:\.php)?/?$ - [F,END,NC]

# Mantener rutas existentes con o sin .php, sin redirecciones a rutas físicas.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([A-Za-z0-9_]+)$ $1.php [END]
